# -----------------------------------------------------------------------------
# Core App
# -----------------------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=1337
STRAPI_PUBLIC_URL=http://localhost:1337

# -----------------------------------------------------------------------------
# Strapi Auth / Security
# -----------------------------------------------------------------------------
APP_KEYS="replace-me-1,replace-me-2"
API_TOKEN_SALT=replace-me
ADMIN_JWT_SECRET=replace-me
TRANSFER_TOKEN_SALT=replace-me
JWT_SECRET=replace-me
ENCRYPTION_KEY=replace-me

# -----------------------------------------------------------------------------
# Database
# Local development may use sqlite.
# Production should use:
#   DATABASE_CLIENT=postgres
#   DATABASE_URL=<railway postgres url>
# -----------------------------------------------------------------------------
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
DATABASE_URL=
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SCHEMA=public
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_CONNECTION_TIMEOUT=60000
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# -----------------------------------------------------------------------------
# Upload / Cloudinary
# Required in production when using the configured Cloudinary upload provider.
# -----------------------------------------------------------------------------
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# -----------------------------------------------------------------------------
# CORS
# Comma-separated list of allowed origins for production hardening.
# Required in production. Wildcard "*" is not allowed.
# Add preview domains only if explicitly intended.
# -----------------------------------------------------------------------------
CORS_ORIGIN=https://www.crearetravel.com,https://crearetravel.com

# -----------------------------------------------------------------------------
# Bootstrap Safety
# Production placeholder seed is disabled by default and only runs when true.
# -----------------------------------------------------------------------------
ENABLE_PRODUCTION_PLACEHOLDER_SEED=false

# -----------------------------------------------------------------------------
# Inquiry Protection
# -----------------------------------------------------------------------------
INQUIRY_HONEYPOT_FIELD=website
INQUIRY_RATE_LIMIT_WINDOW_MS=60000
INQUIRY_RATE_LIMIT_MAX_REQUESTS=5
